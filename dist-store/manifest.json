{
  "manifest_version": 3,
  "name": "GTAB - Kişiselleştirilebilir Başlangıç Sayfası",
  "version": "5.2.0",
  "key": "",
  "description": "Kendi kişiselleştirilebilir yeni sekme sayfanız. Kısayollar, görevler, arama ve daha fazlası.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GTab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://tasks.googleapis.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://www.alphavantage.co/*",
    "https://api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*",
    "https://api.rss2json.com/*",
    "https://api.github.com/*"
  ],
  "oauth2": {
    "client_id": "845733064613-ehbgo67a20brfs0292cfr9tr7k0079m3.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile",
      "https://www.googleapis.com/auth/gmail.metadata",
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/tasks"
    ]
  }
}